{
  "name": "@claudia/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "godspeed:fetch": "tsx scripts/godspeed/fetch.ts",
    "godspeed:import": "tsx scripts/godspeed/import.ts",
    "token:create": "tsx scripts/create-token.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply claudia --local",
    "db:migrate:remote": "wrangler d1 migrations apply claudia --remote",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@claudia/shared": "*",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@hono/zod-openapi": "^0.19.0",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.30.1",
    "drizzle-orm": "^0.45.4",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.6.0",
    "rrule": "^2.8.1",
    "ulidx": "^2.4.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.152.0"
  }
}
